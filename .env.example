# ===== ひとこま 環境変数の例 =====
# ローカル開発では、このファイルを .env.local にコピーして使います。

# PostgreSQL 接続文字列
#   ローカル: `npm run db` で起動する組み込みPostgreSQL
#   本番    : Neon などの接続文字列（Vercel の Storage 連携で自動設定）
DATABASE_URL=postgres://postgres:postgres@localhost:54329/hitokoma

# 自動テスト（統合テスト）用のDB
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:54329/hitokoma_test

# 画像の保存先: local（.data/uploads に保存） / blob（Vercel Blob）
STORAGE_DRIVER=local
# Vercel Blob を使う場合のトークン（Vercel の Storage 連携で自動設定）
# BLOB_READ_WRITE_TOKEN=
# Blob ストアを private で作成した場合は private（既定は public）
# BLOB_ACCESS=public

# 初期管理者アカウント（`npm run seed` または初回マイグレーション後に作成）
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please

# デバッグモード（true で有効。全ユーザーにデバッグパネルを表示。本番運用では false）
DEBUG_MODE=true

# 合言葉（設定すると、合言葉を一度入力した端末だけがアプリを開ける。実験的な配布用。未設定なら制限なし）
# ACCESS_CODE=
